{
  "log": { "level": "info", "timestamp": true },
  "inbounds": [{
    "type": "socks",
    "tag": "socks-in",
    "listen": "0.0.0.0",
    "listen_port": 10808
  }],
  "outbounds": [{
    "type": "vless",
    "tag": "proxy",
    "server": "__SERVER__",
    "server_port": 443,
    "uuid": "__UUID__",
    "flow": "xtls-rprx-vision",
    "tls": {
      "enabled": true,
      "server_name": "__SNI__",
      "utls": { "enabled": true, "fingerprint": "chrome" },
      "reality": {
        "enabled": true,
        "public_key": "__PBK__",
        "short_id": "__SID__"
      }
    }
  }, {
    "type": "direct",
    "tag": "direct"
  }],
  "route": {
    "rules": [
      { "geoip": "private", "outbound": "direct" }
    ],
    "auto_detect_interface": true,
    "final": "proxy"
  }
}